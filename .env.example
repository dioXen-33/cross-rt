# Ce fichier est entierement optionnel : l'outil demarre sans .env.
# Il n'y a plus d'identifiants d'API a fournir, les comptes se connectent
# directement dans une fenetre Chromium.

# Port de l'interface locale.
PORT=3000

# Interface d'ecoute. 127.0.0.1 = accessible uniquement depuis cette machine.
# Sur un serveur distant, GARDEZ cette valeur et passez par un tunnel SSH :
#   ssh -L 3000:127.0.0.1:3000 user@serveur
# Ne mettez 0.0.0.0 que derriere un pare-feu ET avec un UI_PASSWORD.
HOST=127.0.0.1

# Mot de passe pour ouvrir l'interface (vide = pas d'authentification).
# Recommande : l'interface donne acces a des sessions X deja connectees.
UI_PASSWORD=
